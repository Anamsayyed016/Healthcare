generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Contact enquiry submissions from the website form.
/// Maps to table `enquiries` — isolated PharmEFC database only.
model Enquiry {
  id        String   @id @default(cuid())
  fullName  String
  company   String?
  email     String
  phone     String
  subject   String
  service   String
  message   String
  status    String   @default("New")
  source    String   @default("Website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enquiries")
}
