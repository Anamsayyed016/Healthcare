generator client {
  provider      = "prisma-client-js"
  // native = CI/local; debian-openssl-3.0.x = Hostinger Ubuntu 24.04 VPS
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Contact enquiry submissions from the website form.
/// Maps to table `enquiries` — isolated PharmEFC database only.
model Enquiry {
  id        String   @id @default(cuid())
  fullName  String
  company   String?
  email     String
  phone     String
  subject   String
  service   String
  message   String
  status    String   @default("New")
  source    String   @default("Website")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enquiries")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  status      String    @default("Active")
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id               String    @id @default(cuid())
  name             String
  brandName        String?
  slug             String    @unique
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryName     String
  categoryBadge    String?
  icon             String    @default("pill")
  shortDescription String
  longDescription  String?
  composition      String[]  @default([])
  benefits         String[]  @default([])
  indications      String[]  @default([])
  suitableFor      String[]  @default([])
  cardHighlights   String[]  @default([])
  packSize         String?
  dosage           String?
  storage          String?
  prescriptionType String?
  manufacturing    String?
  qualityStandards String?
  relatedSlugs     String[]  @default([])
  mainImage        String?
  gallery          String[]  @default([])
  brochure         String?
  featured         Boolean   @default(false)
  status           String    @default("Draft")
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  sortOrder        Int       @default(0)
  viewCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("products")
}

/// Singleton-style site settings (always use the first / only row).
model SiteSettings {
  id                String   @id @default(cuid())
  companyName       String
  logoUrl           String?
  faviconUrl        String?
  addressLine1      String?
  addressLine2      String?
  addressLine3      String?
  email             String?
  phone             String?
  whatsappNumber    String?
  mapEmbedUrl       String?
  mapLinkUrl        String?
  facebookUrl       String?
  linkedinUrl       String?
  instagramUrl      String?
  twitterUrl        String?
  footerText        String?
  businessHoursDays String?
  businessHoursTime String?
  websiteUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}
