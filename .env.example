# PharmEFC only — do not reuse Naukrimili credentials
DATABASE_URL="postgresql://pharmefc_user:YOUR_PASSWORD@127.0.0.1:5432/pharmefc"
NODE_ENV=production
PORT=3001

# Admin CMS session signing (required)
ADMIN_SESSION_SECRET="replace-with-long-random-secret"

# Initial admin seed credentials — set locally/on VPS only; never commit real values
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="set-a-strong-password"
ADMIN_SEED_NAME="PharmEFC Administrator"

# Cloudinary (required for admin image uploads)
CLOUDINARY_CLOUD_NAME="wslwkiwr"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
